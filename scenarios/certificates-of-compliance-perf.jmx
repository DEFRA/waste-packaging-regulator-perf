      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments">
        <collectionProp name="Arguments.arguments">
          <elementProp name="DASHBOARD_HOST" elementType="Argument">
            <stringProp name="Argument.name">DASHBOARD_HOST</stringProp>
            <stringProp name="Argument.value">${__P(DASHBOARD_HOST,waste-regulator-dashboard-fe.perf-test.cdp-int.defra.cloud)}</stringProp>
